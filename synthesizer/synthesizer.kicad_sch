	(label "LCD_RST" (at 337.82 196.85 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "06321cc5-7251-51a3-917d-2adfce5d084d"))
	(label "VS_XRST" (at 431.8 186.69 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "0bdfde7e-9110-50cf-8434-61fb44533012"))
	(label "VS_XCS" (at 431.8 189.23 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "a8771045-50dd-502a-8e4e-24a017cd3eeb"))
	(label "VS_XDCS" (at 431.8 194.31 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "5772bce8-4a07-566f-b1c6-f16a77cbb100"))
	(label "LCD_RST" (at 236.22 139.7 270) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "acabc80c-4a85-515f-b475-dfe120a754ea"))
	(label "MCP_INT" (at 162.56 259.08 90) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "e9f25833-6c88-567a-ad8d-f63ded8bc338"))
	(label "ENC5_SW" (at 116.84 299.72 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "dd1c8191-f63d-5ca6-a1e6-f7a436cacb27"))
	(text "STOP" (exclude_from_sim no) (at 373.52 132.08 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left)) (uuid "61bc30b2-9a21-5d27-954c-3844a118cdfb"))
	(text "INST" (exclude_from_sim no) (at 100.47 163.83 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left)) (uuid "5f077be4-9bc0-50b4-b0dc-6cc466b113b6"))
	(text "PLAY" (exclude_from_sim no) (at 335.42 259.08 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left)) (uuid "1f5dc2be-cbd0-5284-a4c8-dfc6283a3a1f"))
	(text "D4: Black Pill USB and the adapter" (exclude_from_sim no) (at 147.32 76.2 0) (effects (font (size 1 1)) (justify left)) (uuid "ad203792-37bf-5a12-bdb1-9bcb8838d11f"))
	(text "never back-feed each other." (exclude_from_sim no) (at 147.32 78.74 0) (effects (font (size 1 1)) (justify left)) (uuid "bc70af29-9956-5c28-9b2a-dfc84311dc01"))
	(text "FB1 keeps LED / TFT noise" (exclude_from_sim no) (at 193.04 76.2 0) (effects (font (size 1 1)) (justify left)) (uuid "5aa05904-fbcf-5806-b19b-072f4e774418"))
	(text "out of the audio supply." (exclude_from_sim no) (at 193.04 78.74 0) (effects (font (size 1 1)) (justify left)) (uuid "2fb7d5ef-2601-5bb1-b642-511475b58c0a"))
	(text "+3V3 = Black Pill LDO (300 mA)," (exclude_from_sim no) (at 254 76.2 0) (effects (font (size 1 1)) (justify left)) (uuid "254c9cb2-3234-5071-a609-955e22a23ebc"))
	(text "logic only." (exclude_from_sim no) (at 254 78.74 0) (effects (font (size 1 1)) (justify left)) (uuid "9b42c31f-083c-5ee5-8700-4187d26c8541"))
	(text "NOTES" (exclude_from_sim no) (at 20.32 322.58 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left)) (uuid "2146e22c-6ef8-52a2-921d-065da04754d5"))
	(text "1. Same circuit as v2 (76 nets, same parts and footprints), drawn with wires." (exclude_from_sim no) (at 20.32 327.66 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "ccdbc80c-7439-555e-9478-7e3dc74e5f2b"))
	(text "2. Six signals connect by net label instead of a long wire: VS_XRST, VS_XCS, VS_XDCS, LCD_RST, MCP_INT, ENC5_SW." (exclude_from_sim no) (at 20.32 332.74 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "cd7eb8b0-f610-5363-b0bb-e16bd0e166da"))
	(text "3. Rails: +5V (TFT, NeoTrellis, MIDI), +5V_BP (Black Pill via D4), +5VA (VS1053, PCM5102A via FB1), +3V3 (logic)." (exclude_from_sim no) (at 20.32 337.82 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "f2c10728-bdbf-5494-9555-a1b636fb6a30"))
	(text "4. Budget: about 0.45 A typical, 1.1 A max with NeoTrellis LEDs capped at 0.5 A. Use a 5 V 3 A USB-C adapter." (exclude_from_sim no) (at 20.32 342.9 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "180478a7-840a-5234-b270-199a1464b2bf"))
	(text "5. G474 link: SYN_TX = F411 PA15 -> G474 RX, SYN_RX = G474 TX -> F411 PB3. Nucleo dev: keep JP1 open." (exclude_from_sim no) (at 20.32 347.98 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "3dc5fd90-aae5-5833-8344-721efba38f7f"))
	(text "6. Series R: 100R on UART, 33R on I2S. PCM5102A pin 6 (SCK) is tied to GND." (exclude_from_sim no) (at 20.32 353.06 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "d8fc3bbe-845c-5402-aa8e-bca767703a6c"))
	(text "7. MIDI IN: DIN pin 2 has no ground connection. MIDI OUT: 220R on pins 4 and 5." (exclude_from_sim no) (at 20.32 358.14 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "6b0b7374-28d9-5302-9ee1-0e753d20a255"))
	(text "8. I2C1 PB8/PB9: MCP23017 0x20 (A0-A2 = GND), NeoTrellis 0x2E and 0x2F (A0 bridged), INT shared." (exclude_from_sim no) (at 20.32 363.22 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "3c506109-8341-5e19-828f-f5bda22aec0c"))
	(text "9. MCP23017 GPA7/GPB7 unused (output-only on current silicon). Encoders use the MCP weak pull-ups." (exclude_from_sim no) (at 20.32 368.3 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "b2f291a2-2ebf-5956-b16e-c1e1b48c9341"))
	(text "10. Mixer v0 is passive (-6 dB per input, about 5k output): line level only." (exclude_from_sim no) (at 20.32 373.38 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "114a0a06-bc2c-5d51-abb2-16a35fc5b433"))
	(text "GM BACKING BAND  VS1053" (exclude_from_sim no) (at 479.99 144.78 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left)) (uuid "397382a1-ad8c-55b7-96aa-d8d5631496c2"))
	(text "AUDIO MIX v0 (passive)  /  LINE OUT" (exclude_from_sim no) (at 395.61 96.52 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left)) (uuid "fc661dd2-d9ec-5d2b-b106-f53f602044f0"))
	(text "G474 SYNTH LINK  +  PCM5102A DAC" (exclude_from_sim no) (at 132.72 223.52 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left)) (uuid "0f43f6d7-d1df-5915-8fa9-981537742a99"))
	(text "CONTROLS  MCP23017 (I2C 0x20)  +  5 ENCODERS" (exclude_from_sim no) (at 81.92 229.87 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left)) (uuid "a05f6956-c961-5b1f-b8f8-993b5ed499ca"))
	(text "PADS  NeoTrellis x2 (I2C 0x2E / 0x2F)" (exclude_from_sim no) (at 252.1 266.7 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left)) (uuid "85c3a45e-c67d-5fec-ba05-de3b3692fe13"))
	(text "MIDI IN  (opto-isolated)" (exclude_from_sim no) (at 423.55 212.09 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left)) (uuid "12a0b136-5f38-5e7e-b1c2-c0e57293e389"))
	(text "MIDI OUT  (5 V current loop)" (exclude_from_sim no) (at 426.09 254 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left)) (uuid "87ddb9ff-6220-5eb2-829e-4afdddf91753"))
	(text "POWER INPUT  USB-C 5 V 3 A (power only)" (exclude_from_sim no) (at 23.5 35.56 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left)) (uuid "d8d349e1-61e6-5362-ad32-6f6d2417b4c2"))
	(text "POWER RAILS  +5V_BP / +5VA / +3V3" (exclude_from_sim no) (at 142.88 35.56 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left)) (uuid "62c7c54d-6c99-5e2e-819b-e63c00305bee"))
